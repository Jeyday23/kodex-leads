{
  "name": "kodex-leads-seo-copy",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "agent-reach:install": "bash scripts/install-agent-reach.sh",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts",
    "cf:typecheck": "npm run cf:types && tsc -p cloudflare/tsconfig.json --noEmit",
    "cf:test": "node --import tsx --test cloudflare/test/*.test.ts",
    "cf:dev": "wrangler dev --env staging",
    "cf:check": "npm run cf:typecheck && wrangler deploy --dry-run --env staging",
    "cf:deploy:staging": "wrangler deploy --env staging",
    "cf:deploy:production": "wrangler deploy --env production",
    "verify:supabase": "tsx scripts/verify-supabase.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.408.0",
    "next": "^16.2.12",
    "posthog-js": "^1.376.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-intersection-observer": "^11.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
