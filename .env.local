# Local Development Environment
# This configuration supports THREE modes:
# 1. Local storage (default) - Uses .data/seo-store.json (no Supabase needed)
# 2. Remote Supabase - Set NEXT_PUBLIC_SUPABASE_URL and keys below
# 3. Local Supabase - Run `supabase start` and uncomment values below

# ============================================================================
# MODE 1: LOCAL STORAGE (Default - No Setup Required)
# ============================================================================
# This mode is ACTIVE by default. Leave Supabase vars unset to use local storage.
# The app saves to .data/seo-store.json

# ============================================================================
# MODE 2: REMOTE SUPABASE (Optional - For Production/Staging Projects)
# ============================================================================
# Uncomment and fill with your Supabase project credentials:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (public anon key)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# MODE 3: LOCAL SUPABASE (Optional - Requires Docker)
# ============================================================================
# After running `supabase start`, uncomment these:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc1N1cGVyYWRtaW4iOnRydWUsImlzcyI6InN1cGFiYXNlLWRlbW8ifQ.rQL0KZz96XcNI0jZH_c8d0zpT6hMKgtAiXz16MSuP8E

# ============================================================================
# REQUIRED: Cron & Automation
# ============================================================================
CRON_SECRET=test-cron-secret-local-development-only

# ============================================================================
# OPTIONAL: AI Integrations (for answer-engine checks)
# ============================================================================
# Leave unset to skip these checks in cron

# Claude / Anthropic
ANTHROPIC_API_KEY=

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ============================================================================
# OPTIONAL: Search & Integration
# ============================================================================
# Google Search Console (for indexing data)
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
# GSC_SITE_URL=

# IndexNow (for instant indexing)
# INDEXNOW_KEY=

# Hunter.io (for email enrichment)
# HUNTER_API_KEY=

# Slack Webhooks (for lead notifications)
# SLACK_WEBHOOK_URL=

# HubSpot (for contact sync)
# HUBSPOT_PRIVATE_APP_TOKEN=

# ============================================================================
# OPTIONAL: Site Configuration
# ============================================================================
# For local dev, the app defaults to hardcoded URLs.
# Set this when deployed to a custom domain:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable/disable features for testing
SEO_SOURCE_FETCH_ENABLED=false
