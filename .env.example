# Existing public app settings
NEXT_PUBLIC_SITE_URL=https://kodex-compliance.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key. Keep this in Render server/worker environment variables only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Existing automation secret used by protected cron endpoints.
CRON_SECRET=replace-with-a-strong-random-secret

# Private autonomy controls. The dashboard may remain public, but mode changes/manual runs require this secret.
AUTOPILOT_CONTROL_SECRET=replace-with-a-different-strong-random-secret
# Scheduled autonomy is disabled unless this is explicitly set to true on the services that execute scheduled jobs.
AUTOPILOT_SCHEDULE_ENABLED=false

# Existing LLM provider variable names reused by the Authority Engine.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-sonnet-latest
PERPLEXITY_API_KEY=your-perplexity-api-key
PERPLEXITY_MODEL=sonar

# Lead intelligence and decision-maker discovery.
# Hunter can return professional email addresses and may consume Hunter search credits.
HUNTER_API_KEY=
# Optional Apollo People API Search. The search endpoint is used for role/name discovery; availability depends on the Apollo plan.
APOLLO_API_KEY=
# Optional North Data Data API key for recent German GmbH/UG/other LLC-family registrations.
NORTHDATA_API_KEY=
# Limits paid/contact enrichment attempts in one discovery run. Company discovery can still return more leads.
LEAD_ENRICHMENT_MAX_PER_RUN=12

# Existing optional integrations.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
SLACK_WEBHOOK_URL=
HUBSPOT_PRIVATE_APP_TOKEN=
SEO_SOURCE_FETCH_ENABLED=false

# Founder Ops dashboard. AIRTABLE_ACCESS_TOKEN is server-only and must never use NEXT_PUBLIC_.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_DEALS_TABLE_ID=
AIRTABLE_TASKS_TABLE_ID=
FOUNDER_OPS_GITHUB_REPOSITORY=Jeyday23/kodex-leads
# Optional for private repositories or higher GitHub API limits.
GITHUB_TOKEN=
